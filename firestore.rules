rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Resellers catalog
    match /resellers/{resellerId} {
      allow read: if true;
      allow write: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Daily work logs
    match /daily_work/{workId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Users & profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }
  }
}
